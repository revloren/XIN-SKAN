<Application x:Class="XINSkan.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:XINSkan.App.Infrastructure"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <infra:BoolToVisibility x:Key="BoolToVisibility" />
      <infra:NullToVisibility x:Key="NullToVisibility" />
      <infra:AvailabilityBrush x:Key="AvailabilityBrush" />
      <infra:ReadyBrush x:Key="ReadyBrush" />
      <infra:IntegrityBrush x:Key="IntegrityBrush" />
      <infra:CountFormat x:Key="CountFormat" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
