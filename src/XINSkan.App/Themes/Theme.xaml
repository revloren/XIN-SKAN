<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    XIN SKAN visual tokens.
    Base: graphite with a cool cast (not tinted black), so long reading sessions stay calm.
    Accent: "ember" orange gradient, used in exactly two places: the primary action and live progress.
    Glass: translucent white layers with a top highlight, only on rail icons, ghost buttons and the selected card.
    Type: Bahnschrift for headings and figures (DIN-like, built into Windows 10/11), Segoe UI Variable for text.
  -->

  <!-- Colours -->
  <Color x:Key="WindowColor">#15181F</Color>
  <Color x:Key="SurfaceColor">#1B1F27</Color>
  <Color x:Key="RaisedColor">#222733</Color>
  <Color x:Key="HairlineColor">#2C3240</Color>
  <Color x:Key="TextColor">#E8EAF0</Color>
  <Color x:Key="MutedColor">#8C95A6</Color>
  <Color x:Key="EmberStart">#FF9F4A</Color>
  <Color x:Key="EmberEnd">#F2521B</Color>
  <Color x:Key="OkColor">#6FCF97</Color>
  <Color x:Key="WarnColor">#E8B04B</Color>
  <Color x:Key="FailColor">#FF6B5A</Color>

  <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
  <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
  <SolidColorBrush x:Key="FailBrush" Color="{StaticResource FailColor}" />
  <SolidColorBrush x:Key="EmberSolidBrush" Color="{StaticResource EmberEnd}" />

  <LinearGradientBrush x:Key="EmberBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource EmberStart}" Offset="0" />
    <GradientStop Color="{StaticResource EmberEnd}" Offset="1" />
  </LinearGradientBrush>

  <!-- Wide, low-contrast ember wash for the one hero band on the dashboard. -->
  <LinearGradientBrush x:Key="EmberWashBrush" StartPoint="0,0" EndPoint="1,0.6">
    <GradientStop Color="#3DFF8A3D" Offset="0" />
    <GradientStop Color="#14F2521B" Offset="0.55" />
    <GradientStop Color="#001B1F27" Offset="1" />
  </LinearGradientBrush>

  <!-- Frosted glass: a translucent body and a brighter rim that fades downwards. -->
  <LinearGradientBrush x:Key="GlassFillBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2EFFFFFF" Offset="0" />
    <GradientStop Color="#0AFFFFFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassRimBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#66FFFFFF" Offset="0" />
    <GradientStop Color="#12FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassHighlightBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#24FFFFFF" Offset="0" />
    <GradientStop Color="#00FFFFFF" Offset="1" />
  </LinearGradientBrush>

  <!-- Type -->
  <FontFamily x:Key="DisplayFont">Bahnschrift</FontFamily>
  <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="21" />
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="Figure" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- Surfaces: cards 14, buttons 12, chips 8 — radius follows hierarchy. -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="24" />
  </Style>

  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
  </Style>

  <!-- Primary action: the ember button. One per screen. -->
  <Style x:Key="EmberButton" TargetType="Button">
    <Setter Property="Foreground" Value="#1A0E06" />
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="26,13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" CornerRadius="12" Background="{StaticResource EmberBrush}" Padding="{TemplateBinding Padding}"
                  BorderThickness="2" BorderBrush="Transparent">
            <Border.Effect>
              <DropShadowEffect Color="{StaticResource EmberEnd}" BlurRadius="18" ShadowDepth="0" Opacity="0.35" />
            </Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="{StaticResource EmberEnd}" BlurRadius="30" ShadowDepth="0" Opacity="0.6" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Body" Property="Background" Value="{StaticResource RaisedBrush}" />
              <Setter TargetName="Body" Property="Effect" Value="{x:Null}" />
              <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Transparent glass button with a soft glow on hover. -->
  <Style x:Key="GlassButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Body" CornerRadius="12" Background="{StaticResource GlassFillBrush}" BorderBrush="{StaticResource GlassRimBrush}" BorderThickness="1" />
            <Border CornerRadius="12,12,0,0" Height="14" VerticalAlignment="Top" Margin="1" Background="{StaticResource GlassHighlightBrush}" IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#FFFFFFFF" BlurRadius="16" ShadowDepth="0" Opacity="0.18" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Window caption buttons -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="Background" Value="{StaticResource RaisedBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Navigation rail: each item is a frosted-glass tile; the selected one carries the ember outline. -->
  <Style x:Key="RailItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ToolTip" Value="{Binding Title}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Width="48" Height="48">
            <Border x:Name="Glass" CornerRadius="14" Background="{StaticResource GlassFillBrush}" BorderBrush="{StaticResource GlassRimBrush}" BorderThickness="1" Opacity="0.55" />
            <Border CornerRadius="14,14,0,0" Height="16" VerticalAlignment="Top" Margin="1" Background="{StaticResource GlassHighlightBrush}" IsHitTestVisible="False" />
            <Path x:Name="Icon" Data="{Binding Icon}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.7"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Glass" Property="Opacity" Value="0.9" />
              <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Glass" Property="Opacity" Value="1" />
              <Setter TargetName="Glass" Property="BorderBrush" Value="{StaticResource EmberBrush}" />
              <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource EmberBrush}" />
              <Setter TargetName="Glass" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="{StaticResource EmberEnd}" BlurRadius="16" ShadowDepth="0" Opacity="0.35" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Glass" Property="BorderBrush" Value="{StaticResource TextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Plain list rows separated by hairlines (used for readiness, modules, investigations). -->
  <Style x:Key="RowItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,12" Background="Transparent">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{StaticResource RaisedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PlainList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
  </Style>

  <Style x:Key="Field" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
</ResourceDictionary>
