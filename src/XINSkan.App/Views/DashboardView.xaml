<UserControl x:Class="XINSkan.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="40,4,40,36">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.ColumnSpan="3" Text="Проверка компьютера игрока" Style="{StaticResource PageTitle}" Margin="0,0,0,24" />

      <!-- Hero: the last investigation, or an invitation to run the first one. The only ember wash in the app. -->
      <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Background="{StaticResource SurfaceBrush}" Padding="0">
        <Grid>
          <Border CornerRadius="14" Background="{StaticResource EmberWashBrush}" IsHitTestVisible="False" />
          <StackPanel Margin="28,26,28,28">
            <TextBlock Text="Последняя проверка" Style="{StaticResource SectionTitle}" />

            <StackPanel Visibility="{Binding HasLastInvestigation, Converter={StaticResource BoolToVisibility}}" Margin="0,14,0,0">
              <TextBlock Text="{Binding LastInvestigation.Title}" Style="{StaticResource Body}" FontSize="16" />
              <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <StackPanel Margin="0,0,40,0">
                  <TextBlock Text="{Binding LastInvestigation.EvidenceCount, Converter={StaticResource CountFormat}}" Style="{StaticResource Figure}" />
                  <TextBlock Text="свидетельств собрано" Style="{StaticResource Muted}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom">
                  <TextBlock Text="{Binding LastInvestigation.ModulesText}" Style="{StaticResource Body}" />
                  <TextBlock Text="{Binding LastInvestigation.IntegrityText}" Style="{StaticResource Muted}"
                             Foreground="{Binding LastInvestigation.Integrity, Converter={StaticResource IntegrityBrush}}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <TextBlock Visibility="{Binding HasLastInvestigation, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                       Style="{StaticResource Body}" Margin="0,14,0,0" MaxWidth="560" HorizontalAlignment="Left"
                       Text="Проверок ещё не было. XIN SKAN ищет следы Minecraft-клиентов в файлах, истории файловой системы и свидетельствах запуска и ничего не меняет на этом компьютере." />

            <Button Content="Перейти к проверке" Style="{StaticResource EmberButton}" Command="{Binding StartCommand}"
                    HorizontalAlignment="Left" Margin="0,26,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Readiness: live probe results. -->
      <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Обновить" Style="{StaticResource GlassButton}" Padding="14,6" Command="{Binding RefreshCommand}" />
            <TextBlock Text="Готовность системы" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Проверяется…" Style="{StaticResource Muted}"
                     Visibility="{Binding Loading, Converter={StaticResource BoolToVisibility}}" />
          <ItemsControl ItemsSource="{Binding Readiness}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                  <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,6,12,0" VerticalAlignment="Top"
                             Fill="{Binding Available, Converter={StaticResource AvailabilityBrush}}" />
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                      <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <!-- What this build can do: status comes from ModuleCatalog, which changes only with tested code. -->
      <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,24,0,0">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Bottom">
              <Run Text="Анализаторов готово:" />
              <Run Text="{Binding ReadyAnalyzersText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="Модули проверки" Style="{StaticResource SectionTitle}" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Foundation}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="220" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                    <TextBlock Grid.Column="1" Text="{Binding Purpose}" Style="{StaticResource Muted}" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource Body}" Foreground="{Binding IsReady, Converter={StaticResource ReadyBrush}}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Analyzers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="220" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                    <TextBlock Grid.Column="1" Text="{Binding Purpose}" Style="{StaticResource Muted}" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource Body}" Foreground="{Binding IsReady, Converter={StaticResource ReadyBrush}}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
