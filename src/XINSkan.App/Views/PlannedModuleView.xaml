<UserControl x:Class="XINSkan.App.Views.PlannedModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="40,4,40,36" MaxWidth="720" HorizontalAlignment="Left">
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
    <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Margin="0,12,0,0" />
    <Border Style="{StaticResource Card}" Margin="0,24,0,0">
      <TextBlock Text="{Binding StageText}" Style="{StaticResource Muted}" />
    </Border>
  </StackPanel>
</UserControl>
