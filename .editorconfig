root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,xml,xaml,json,yml,yaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
dotnet_sort_system_directives_first = true

# Library code does not need ConfigureAwait noise; there is no SynchronizationContext in the core.
dotnet_diagnostic.CA2007.severity = none
# Messages are written for the operator and are not localised through resources in 1.0.
dotnet_diagnostic.CA1303.severity = none
# Enum and record names are part of the evidence schema and are intentionally plural/short where they are.
dotnet_diagnostic.CA1711.severity = none

[tests/**.cs]
# Test method names use underscores for readability.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA1861.severity = none

[src/XINSkan.App/**.cs]
# The desktop app is an executable; its public view models and converters are bound from XAML.
dotnet_diagnostic.CA1515.severity = none
