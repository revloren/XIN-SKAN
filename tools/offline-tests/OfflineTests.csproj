<Project Sdk="Microsoft.NET.Sdk">
  <!-- Local, NuGet-free runner for tests/XINSkan.UnitTests. Not part of the solution or CI.
       Build with: dotnet run -p:XinOffline=true -project tools/offline-tests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>XINSkan.UnitTests</AssemblyName>
    <RootNamespace>XINSkan.UnitTests</RootNamespace>
    <XinOffline>true</XinOffline>
    <XinEnforceReadOnly>false</XinEnforceReadOnly>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1852;CA1822;CA1031;CA2000;CA1062;CA1716;CA1720;CA1030;CA1819;CA1861;IDE0005;CA1305;CA1307;CA1310;CA1309;CA2201;CA1847;CA1866;CA1865;CA1806</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../tests/XINSkan.UnitTests/**/*.cs" Exclude="../../tests/XINSkan.UnitTests/obj/**;../../tests/XINSkan.UnitTests/bin/**" />
    <Compile Include="../../tests/XINSkan.SecurityTests/**/*.cs" Exclude="../../tests/XINSkan.SecurityTests/obj/**;../../tests/XINSkan.SecurityTests/bin/**" />
    <Compile Include="../../tests/XINSkan.FileHunterTests/**/*.cs" Exclude="../../tests/XINSkan.FileHunterTests/obj/**;../../tests/XINSkan.FileHunterTests/bin/**" />
    <!-- Files named *WithSqlite* need Microsoft.Data.Sqlite (NuGet) and run in CI only. -->
    <Compile Include="../../tests/XINSkan.NtfsTests/**/*.cs" Exclude="../../tests/XINSkan.NtfsTests/obj/**;../../tests/XINSkan.NtfsTests/bin/**" />
    <EmbeddedResource Include="../../tests/XINSkan.NtfsTests/TestData/*.gz" LogicalName="%(Filename)%(Extension)" />
    <Compile Include="../../tests/XINSkan.ShellFormatsTests/**/*.cs" Exclude="../../tests/XINSkan.ShellFormatsTests/obj/**;../../tests/XINSkan.ShellFormatsTests/bin/**" />
    <Compile Include="../../tests/XINSkan.HistoryTests/**/*.cs" Exclude="../../tests/XINSkan.HistoryTests/obj/**;../../tests/XINSkan.HistoryTests/bin/**" />
    <Compile Include="../../tests/XINSkan.ExecutionTests/**/*.cs" Exclude="../../tests/XINSkan.ExecutionTests/obj/**;../../tests/XINSkan.ExecutionTests/bin/**" />
    <Compile Include="../../tests/XINSkan.MinecraftTests/**/*.cs" Exclude="../../tests/XINSkan.MinecraftTests/obj/**;../../tests/XINSkan.MinecraftTests/bin/**" />
    <Compile Include="../../tests/XINSkan.CorrelationTests/**/*.cs" Exclude="../../tests/XINSkan.CorrelationTests/obj/**;../../tests/XINSkan.CorrelationTests/bin/**" />
    <Compile Include="../../tests/XINSkan.InvestigationTests/**/*.cs" Exclude="../../tests/XINSkan.InvestigationTests/obj/**;../../tests/XINSkan.InvestigationTests/bin/**;../../tests/XINSkan.InvestigationTests/**/*WithSqlite*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Xunit.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/XINSkan.Models/XINSkan.Models.csproj" />
    <ProjectReference Include="../../src/XINSkan.Core/XINSkan.Core.csproj" />
    <ProjectReference Include="../../src/XINSkan.Platform.Windows/XINSkan.Platform.Windows.csproj" />
    <ProjectReference Include="../../src/XINSkan.Security/XINSkan.Security.csproj" />
    <ProjectReference Include="../../src/XINSkan.Analyzers.FileHunter/XINSkan.Analyzers.FileHunter.csproj" />
    <ProjectReference Include="../../src/XINSkan.Investigation/XINSkan.Investigation.csproj" />
    <ProjectReference Include="../../src/XINSkan.Ntfs/XINSkan.Ntfs.csproj" />
    <ProjectReference Include="../../src/XINSkan.Analyzers.History/XINSkan.Analyzers.History.csproj" />
    <ProjectReference Include="../../src/XINSkan.ShellFormats/XINSkan.ShellFormats.csproj" />
    <ProjectReference Include="../../src/XINSkan.ExecutionFormats/XINSkan.ExecutionFormats.csproj" />
    <ProjectReference Include="../../src/XINSkan.Analyzers.Execution/XINSkan.Analyzers.Execution.csproj" />
    <ProjectReference Include="../../src/XINSkan.Correlation/XINSkan.Correlation.csproj" />
    <ProjectReference Include="../../src/XINSkan.Analyzers.Minecraft/XINSkan.Analyzers.Minecraft.csproj" />
  </ItemGroup>
</Project>
