<Project Sdk="Microsoft.NET.Sdk">
  <!-- Maintainer tool for the signature database: manifest, keys, signatures. Not part of the application:
       it writes files (database folder, key files) on the maintainer's machine, never on an investigated one. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>xinskan-db</AssemblyName>
    <XinEnforceReadOnly>false</XinEnforceReadOnly>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XINSkan.Signatures\XINSkan.Signatures.csproj" />
  </ItemGroup>
</Project>
